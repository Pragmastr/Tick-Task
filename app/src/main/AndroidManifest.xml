<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Автоматически выдаётся будильным приложениям на Android 13+:
         точные будильники срабатывают даже спустя годы после взвода. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Перезапуск всех будильников после перезагрузки телефона:
         система стирает AlarmManager при выключении, без этого права
         напоминания жили бы только до первого выключения устройства. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Циклическая вибрация будильника. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EliteToDo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EliteToDo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AlarmActivity"
            android:theme="@style/Theme.EliteToDo"
            android:showForAllUsers="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:exported="false" />
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ACTION_LAUNCH_ALARM" />
            </intent-filter>
        </receiver>
        <!-- Кнопка «ОТЛОЖИТЬ» в уведомлении будильника: работает и при убитом
             процессе — глушит сигнал и перевзводит будильник на интервал
             отложки из настроек приложения. -->
        <receiver
            android:name=".SnoozeReceiver"
            android:exported="false" />
        <!-- Восстановление будильников после перезагрузки телефона и после
             обновления приложения: задачи читаются из Go-ядра и взводятся заново. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
